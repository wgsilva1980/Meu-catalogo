NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Usada para identificar automaticamente nome/marca/categoria/descrição a partir da foto do produto
ANTHROPIC_API_KEY=sk-ant-...

# Token do bot do Telegram (criado uma única vez via @BotFather), usado para
# notificar cada empresa em seu próprio telegram_chat_id (configurado em
# Configurações da loja) quando um cliente se cadastra ou faz um pedido
# pelas páginas públicas /cadastro/[slug] e /pedido/[slug]
TELEGRAM_BOT_TOKEN=123456:ABC-...
