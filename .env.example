NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Usada para identificar automaticamente nome/marca/categoria/descrição a partir da foto do produto
ANTHROPIC_API_KEY=sk-ant-...

# Conta Gmail usada para ENVIAR as notificações de novo cadastro/pedido
# (destino configurável por empresa em Configurações da loja). Gere a senha
# em myaccount.google.com/apppasswords (precisa de verificação em 2 etapas
# ativada na conta).
GMAIL_USER=sualoja@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# App único do Melhor Envio compartilhado pela plataforma (cada empresa
# conecta sua própria conta via OAuth2 em Configurações). Cadastre o app em
# app-sandbox.melhorenvio.com.br/integracoes/area-dev (teste) ou
# app.melhorenvio.com.br/integracoes/area-dev (produção) — o redirect_uri
# cadastrado lá precisa ser exatamente
# https://SEU_DOMINIO/admin/configuracoes/melhor-envio/callback
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_ENVIRONMENT=sandbox
MELHOR_ENVIO_USER_AGENT=Meu Catalogo (wagnergarnizet@gmail.com)
# redirect_uri fixo do OAuth. Defina por ambiente (Vercel) com o valor EXATO
# cadastrado no app do Melhor Envio, ex.:
# https://meu-catalogo-orcin.vercel.app/admin/configuracoes/melhor-envio/callback
# Sem esta var, o redirect_uri é derivado do host da requisição (só serve para
# desenvolvimento local).
MELHOR_ENVIO_REDIRECT_URI=
